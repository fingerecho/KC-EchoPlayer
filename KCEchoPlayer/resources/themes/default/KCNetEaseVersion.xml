<?xml version="1.0" encoding="utf-8"?>
<!-- 网易V2版界面：本地音乐 / 最近播放 / 我的收藏 / 设置 + 播放页 -->
<Window size="1280,800" min_size="1024,640" caption="0,0,0,56"
        round_corner="14,14" size_box="4,4,4,4"
        shadow_type="none_round" shadow_attached="true"
        shadow_border_round="14,14" shadow_border_size="0">

    <!-- ===================== 网易V2版局部样式 ===================== -->
    <Class name="ne_nav_item" width="stretch" height="40" border_round="8,8" padding="14,0,14,0"
           text_padding="34,0,0,0" font="system_regular_15" normal_text_color="#FF4C4C57"
           hovered_text_color="#FF1F1F24" selected_normal_text_color="#FFFFFFFF"
           selected_hovered_text_color="#FFFFFFFF" selected_pressed_text_color="#FFFFFFFF"
           normal_color="#00000000" hovered_color="#FFEAEAF2"
           selected_normal_color="#FFF53B4B" selected_hovered_color="#FFF53B4B"
           selected_pressed_color="#FFF53B4B" text_align="vcenter,left"/>
    <Class name="ne_section_title" font="system_bold_13" normal_text_color="#FF9A9AA8" text_align="vcenter"/>
    <Class name="ne_page" width="stretch" height="stretch" bkcolor="#FFFFFFFF" padding="32,24,32,10"/>
    <Class name="ne_solid_page" width="stretch" height="stretch"/>
    <Class name="ne_title" font="system_bold_22" normal_text_color="#FF202026" text_align="vcenter"/>
    <Class name="ne_sub" font="system_regular_13" normal_text_color="#FF8A8A97" text_align="vcenter"/>
    <Class name="ne_body" font="system_regular_14" normal_text_color="#FF4D4D58" text_align="vcenter"/>
    <Class name="ne_muted" font="system_regular_12" normal_text_color="#FFA5A5B2" text_align="vcenter"/>
    <Class name="ne_round_btn" width="38" height="38" border_round="19,19" font="system_regular_15"
           text_align="hcenter,vcenter" normal_text_color="#FF50505C"
           normal_color="#FFF2F2F6" hovered_color="#FFE7E7EE" pressed_color="#FFDDDDE6"/>
    <Class name="ne_ghost_btn" width="auto" height="30" padding="10,0,10,0" border_round="15,15"
           font="system_regular_13" text_align="hcenter,vcenter" normal_text_color="#FF666672"
           normal_color="#00FFFFFF" hovered_text_color="#FFF53B4B" hovered_color="#FFFFF0F1"/>
    <Class name="ne_link_btn" width="auto" height="30" padding="8,0,8,0" font="system_regular_13"
           text_align="hcenter,vcenter" normal_text_color="#FF4C6FFF" hovered_text_color="#FF1F49FF"/>
    <Class name="ne_list" bkcolor="#00FFFFFF" vscrollbar="true"/>
    <Class name="ne_list_row" height="58" border_round="6,6"
           hovered_color="#FFF4F4F8" selected_normal_color="#FFEDEDF3" fade_hovered="false"/>
    <Class name="ne_list_header" height="34" bkcolor="#FFF7F7FA" border_round="4,4"/>
    <Class name="ne_song_title" font="system_regular_15" normal_text_color="#FF222228" text_align="vcenter" valign="center" mouse_enabled="false"/>
    <Class name="ne_song_title_red" font="system_regular_15" normal_text_color="#FFF53B4B" text_align="vcenter" valign="center" mouse_enabled="false"/>
    <Class name="ne_song_artist" font="system_regular_12" normal_text_color="#FF8A8A97" text_align="vcenter" valign="center" mouse_enabled="false"/>
    <Class name="ne_song_artist_red" font="system_regular_12" normal_text_color="#FFF53B4B" text_align="vcenter" valign="center" mouse_enabled="false"/>
    <Class name="ne_col" font="system_regular_13" normal_text_color="#FF777783" text_align="vcenter" valign="center" mouse_enabled="false"/>
    <Class name="ne_col_light" font="system_regular_13" normal_text_color="#FFB0B0BC" text_align="vcenter" valign="center" mouse_enabled="false"/>
    <Class name="ne_cover_small" border_round="6,6" bkcolor="#FFF53B4B" valign="center" mouse_enabled="false"/>
    <Class name="ne_cover_text" font="system_regular_14" normal_text_color="#FFFFFFFF" text_align="hcenter,vcenter"/>
    <Class name="ne_lyric_line" height="30" font="system_regular_15" normal_text_color="#FF8F8F9E" text_align="vcenter,left"/>
    <Class name="ne_lyric_line_active" height="30" font="system_bold_17" normal_text_color="#FFFFFFFF" text_align="vcenter,left"/>
    <Class name="ne_col_red" font="system_regular_13" normal_text_color="#FFF53B4B" text_align="vcenter" valign="center" mouse_enabled="false"/>
    <Class name="ne_settings_card" bkcolor="#FFF8F8FB" border_round="12,12" border_size="1" border_color="#FFE6E6EE" padding="22,18,22,18"/>
    <Class name="ne_setting_title" font="system_bold_16" normal_text_color="#FF202026" text_align="vcenter"/>
    <Class name="ne_setting_desc" font="system_regular_13" normal_text_color="#FF8A8A97" text_align="vcenter"/>
    <Class name="ne_tag_tab" width="auto" height="34" padding="12,0,12,0" border_round="17,17"
           font="system_regular_13" normal_text_color="#FF666672" normal_color="#00FFFFFF"
           hovered_color="#FFF4F4F8" selected_normal_text_color="#FF1F1F24"
           selected_normal_color="#FFEFEFF4" text_align="hcenter,vcenter"/>
    <Class name="ne_play_round" width="52" height="52" border_round="26,26"
           normal_color="#FFF53B4B" hovered_color="#FFE53040" pressed_color="#FFD82131"/>
    <Class name="ne_media_btn" width="52" height="52" border_round="26,26"
           normal_color="#00FFFFFF" hovered_color="#14F53B4B" pressed_color="#22F53B4B"/>
    <Class name="ne_bottom_icon" width="34" height="34" border_round="17,17" font="system_regular_16"
           text_align="hcenter,vcenter" normal_text_color="#FF3E3E49"
           hovered_text_color="#FFF53B4B" hovered_color="#FFF4F4F8" pressed_color="#FFEDEDF3"/>
    <Class name="ne_bottom_cover" width="56" height="56" border_round="28,28" font="system_bold_20"
           text_align="hcenter,vcenter" normal_text_color="#FFFFFFFF"
           normal_color="#FF3C3C48" hovered_color="#FF50505E" pressed_color="#FF2E2E38"/>
    <Class name="ne_chip" width="auto" height="26" padding="9,0,9,0" border_round="13,13"
           border_size="1" border_color="#FFD7D7E0" font="system_regular_12"
           text_align="hcenter,vcenter" normal_text_color="#FF6B6B78"
           normal_color="#00FFFFFF" hovered_color="#FFF4F4F8"/>
    <Class name="ne_player_icon" width="42" height="42" border_round="21,21" font="system_regular_16"
           text_align="hcenter,vcenter" normal_text_color="#FFDADAE6"
           normal_color="#00FFFFFF" hovered_color="#FF35353F" pressed_color="#FF2A2A34"/>
    <Class name="ne_player_back" width="50" height="50" border_round="25,25" font="system_bold_18"
           text_align="hcenter,vcenter" normal_text_color="#FFFFFFFF"
           normal_color="#FF35353F" hovered_color="#FF474752" pressed_color="#FF2A2A34"/>
    <Class name="ne_player_title" font="system_bold_22" normal_text_color="#FFFFFFFF" text_align="vcenter"/>
    <Class name="ne_player_sub" font="system_regular_14" normal_text_color="#FFAFAFBE" text_align="vcenter"/>
    <Class name="ne_player_lyric" font="system_regular_16" normal_text_color="#FF8F8F9E" text_align="vcenter"/>
    <Class name="ne_record_outer" bkcolor="#FF15151B" border_round="210,210"/>
    <Class name="ne_record_inner" bkcolor="#FF353540" border_round="155,155"/>
    <Class name="ne_record_center" bkcolor="#FFB35A3C" border_round="105,105"/>
    <Class name="ne_player_slider" horizontal="true" width="stretch" height="4" min="0" max="1000"
           progress_color="#FFF53B4B" bkcolor="#FF3A3A45" border_round="2,2" progress_radius="2"
           thumb_size="10,10"
           thumb_normal_image="file='${PATH_SLIDER}/slider_thumb.svg' width='10' height='10'"
           thumb_hovered_image="file='${PATH_SLIDER}/slider_thumb_hovered.svg' width='10' height='10'"
           thumb_pressed_image="file='${PATH_SLIDER}/slider_thumb_pressed.svg' width='10' height='10'"/>

    <VBox bkcolor="#FFF8F8FB" width="stretch" height="stretch"
          border_size="1" border_round="14,14" border_color="#FFE6E6EE">

        <!-- ===================== 标题栏：与 KCEchoPlayerMain 排版一致 ===================== -->
        <HBox name="window_title_bar" height="56" bkcolor="#FFFFFFFF" padding="20,0,16,0">
            <HBox valign="center" width="auto" margin="0,15,0,0">
                <Control width="24" height="24" border_round="12,12" bkcolor="#FFF53B4B" margin="0,0,10,0"/>
                <Label class="mc_title_text" text="克铖云音乐"/>
            </HBox>
            <Control width="stretch" height="stretch" mouse_enabled="false"/>
            <Button class="mc_win_btn" name="btn_select_version" text="版本选择" width="76" margin="0,0,6,0"/>
            <HBox valign="center" width="auto" child_margin="6">
                <Button class="mc_win_btn" name="btn_window_min" text="—"/>
                <Button class="mc_win_btn" name="btn_window_max" text="□"/>
                <Button class="mc_win_btn" name="btn_window_restore" text="❐" visible="false"/>
                <Button class="mc_win_btn" name="btn_window_close" text="✕"/>
            </HBox>
        </HBox>

        <!-- ===================== 正常浏览界面 ===================== -->
        <VBox name="ne_body_normal" width="stretch" height="stretch">
            <HBox width="stretch" height="stretch">
                <!-- 左侧菜单 -->
                <VBox width="210" height="stretch" bkcolor="#FFF5F5F8" padding="14,18,14,12" child_margin="6">
                    <Label class="ne_section_title" text="音乐库" height="28" margin="12,0,0,4"/>
                    <Option name="nav_local" class="ne_nav_item" group="ne_nav" selected="true" text="本地音乐"
                            normal_image="file='images/netease/06_music_box_gray.png' width='16' height='16' valign='center'"
                            selected_normal_image="file='images/netease/06_music_box_white.png' width='16' height='16' valign='center'"/>
                    <Option name="nav_recent" class="ne_nav_item" group="ne_nav" text="最近播放"
                            normal_image="file='images/netease/02_circle_l_gray.png' width='16' height='16' valign='center'"
                            selected_normal_image="file='images/netease/02_circle_l_white.png' width='16' height='16' valign='center'"/>
                    <Option name="nav_favorite" class="ne_nav_item" group="ne_nav" text="我的收藏"
                            normal_image="file='images/netease/04_star_gray.png' width='16' height='16' valign='center'"
                            selected_normal_image="file='images/netease/04_star_white.png' width='16' height='16' valign='center'"/>
                    <Option name="nav_settings" class="ne_nav_item" group="ne_nav" text="设置"
                            normal_image="file='images/netease/08_settings_gray.png' width='16' height='16' valign='center'"
                            selected_normal_image="file='images/netease/08_settings_white.png' width='16' height='16' valign='center'"/>
                    <Control width="stretch" height="stretch" mouse_enabled="false"/>
                </VBox>
                <Control width="1" height="stretch" bkcolor="#FFE9E9EF" mouse_enabled="false"/>

                <!-- 右侧内容区 -->
                <VBox width="stretch" height="stretch" bkcolor="#FFFFFFFF">
                    <!-- 本地音乐 -->
                    <VBox name="ne_page_local" class="ne_page">
                        <HBox height="46" valign="center" child_margin="10">
                            <Label class="ne_title" text="本地音乐"/>
                            <Label class="ne_sub" name="lbl_local_count" text="共 0 首"/>
                            <Control width="stretch" height="stretch" mouse_enabled="false"/>
                            <Button class="ne_link_btn" name="btn_choose_dir" text="选择音乐 &gt;"/>
                        </HBox>

                        <HBox height="48" valign="center" child_margin="10">
                            <Button class="ne_primary_btn" text="播放全部"/>
                        </HBox>

                        <HBox class="ne_list_header" width="stretch" padding="13,0,13,0" child_margin="10" valign="center">
                            <Label class="ne_col_light" text="#" width="36"/>
                            <Label class="ne_col" text="标题" width="stretch"/>
                            <Label class="ne_col" text="专辑" width="210"/>
                            <Label class="ne_col" text="时长" width="80"/>
                            <Label class="ne_col" text="大小" width="80"/>
                        </HBox>

                        <VListBox name="ne_local_list" class="ne_list" width="stretch" height="stretch" margin="0,6,0,0"></VListBox>
                    </VBox>

                    <!-- 最近播放 -->
                    <VBox name="ne_page_recent" class="ne_page" visible="false">
                        <HBox height="44" valign="center" child_margin="8">
                            <Button class="ne_tag_tab" name="btn_recent_single_tab" text="单曲 0"/>
                            <Control width="stretch" height="stretch" mouse_enabled="false"/>
                            <Button class="ne_primary_btn" text="播放全部"/>
                            <Button class="ne_secondary_btn" text="收藏全部"/>
                        </HBox>

                        <HBox class="ne_list_header" width="stretch" padding="13,0,13,0" child_margin="10" valign="center" margin="0,10,0,0">
                            <Label class="ne_col_light" text="#" width="36"/>
                            <Label class="ne_col" text="标题" width="stretch"/>
                            <Label class="ne_col" text="专辑" width="250"/>
                            <Label class="ne_col" text="喜欢" width="60"/>
                            <Label class="ne_col" text="播放时间" width="90"/>
                        </HBox>

                        <VListBox name="ne_recent_list" class="ne_list" width="stretch" height="stretch" margin="0,6,0,0"></VListBox>
                    </VBox>

                    <!-- 我的收藏 -->
                    <VBox name="ne_page_favorite" class="ne_page" visible="false">
                        <HBox height="46" valign="center" child_margin="10">
                            <Label class="ne_title" text="我的收藏"/>
                            <Label class="ne_sub" name="lbl_favorite_count" text="共 0 首"/>
                            <Control width="stretch" height="stretch" mouse_enabled="false"/>
                        </HBox>

                        <HBox class="ne_list_header" width="stretch" padding="13,0,13,0" child_margin="10" valign="center" margin="0,10,0,0">
                            <Label class="ne_col_light" text="#" width="36"/>
                            <Label class="ne_col" text="标题" width="stretch"/>
                            <Label class="ne_col" text="专辑" width="220"/>
                            <Label class="ne_col" text="收藏时间" width="150"/>
                            <Label class="ne_col" text="播放次数" width="80"/>
                            <Label class="ne_col" text="操作" width="100"/>
                        </HBox>

                        <VListBox name="ne_favorite_list" class="ne_list" width="stretch" height="stretch" margin="0,6,0,0"></VListBox>
                    </VBox>

                    <!-- 设置 -->
                    <VBox name="ne_page_settings" class="ne_page" visible="false">
                        <HBox height="46" valign="center">
                            <Label class="ne_title" text="设置"/>
                        </HBox>

                        <VBox class="ne_settings_card" width="stretch" height="auto" margin="0,10,0,0">
                            <HBox height="54" valign="center" child_margin="18">
                                <VBox width="stretch" height="auto" valign="center" child_margin="4">
                                    <Label class="ne_setting_title" text="开机自动运行"/>
                                    <Label class="ne_setting_desc" text="登录 Windows 后自动启动克铖播放器"/>
                                </VBox>
                                <CheckBox name="chk_auto_start" width="40" height="40" valign="center"
                                          normal_image="file='public/checkbox/checkbox-outline-unchecked.svg' width='22' height='22' valign='center' halign='center'"
                                          selected_normal_image="file='public/checkbox/checkbox-outline-checked.svg' width='22' height='22' valign='center' halign='center'"/>
                            </HBox>
                        </VBox>

                        <VBox class="ne_settings_card" width="stretch" height="auto" margin="0,14,0,0">
                            <HBox height="54" valign="center" child_margin="18">
                                <VBox width="stretch" height="auto" valign="center" child_margin="4">
                                    <Label class="ne_setting_title" text="程序启动时自动播放"/>
                                    <Label class="ne_setting_desc" text="启动后自动播放本地音乐中的第一首歌曲"/>
                                </VBox>
                                <CheckBox name="chk_auto_play" width="40" height="40" valign="center"
                                          normal_image="file='public/checkbox/checkbox-outline-unchecked.svg' width='22' height='22' valign='center' halign='center'"
                                          selected_normal_image="file='public/checkbox/checkbox-outline-checked.svg' width='22' height='22' valign='center' halign='center'"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>
            </HBox>

            <!-- ===================== 底部播放控制栏（正常界面） ===================== -->
            <VBox name="ne_bottom_normal" width="stretch" height="92" bkcolor="#FFFFFFFF">
                <Slider name="ne_progress" class="ne_progress_slider" width="stretch" height="4"/>
                <HBox width="stretch" height="stretch" padding="24,0,24,0">
                    <HBox width="240" height="stretch" valign="center" child_margin="12">
                        <Button name="btn_show_player" class="ne_bottom_cover" text="封面" valign="center"/>
                        <VBox width="stretch" height="auto" valign="center" child_margin="2">
                            <Label class="ne_song_title" name="ne_bottom_title" text="未选择"/>
                            <Label class="ne_song_artist" name="ne_bottom_artist" text=""/>
                        </VBox>
                    </HBox>
                    <Control width="stretch" height="stretch" mouse_enabled="false"/>
                    <HBox valign="center" child_margin="24" width="204">
                        <Button name="btn_ne_prev" class="ne_media_btn" valign="center"
                                normal_image="file='images/netease/prev_52.png' width='52' height='52' valign='center' halign='center'"/>
                        <Button name="btn_ne_play_pause" class="ne_play_round" valign="center"
                                normal_image="file='images/netease/play_52.png' width='24' height='24' valign='center' halign='center'"/>
                        <Button name="btn_ne_next" class="ne_media_btn" valign="center"
                                normal_image="file='images/netease/next_52.png' width='52' height='52' valign='center' halign='center'"/>
                    </HBox>
                    <Control width="stretch" height="stretch" mouse_enabled="false"/>
                    <Control width="240" height="stretch" mouse_enabled="false"/>
                </HBox>
                <Label name="ne_progress_tip" class="ne_progress_tip" float="true"
                       width="120" height="24" visible="false" text="00:00 / 00:00"/>
            </VBox>
        </VBox>

        <!-- ===================== 全屏播放界面 ===================== -->
        <VBox name="ne_body_player" width="stretch" height="stretch" visible="false" bkcolor="#FF202026">
            <HBox width="stretch" height="stretch" padding="36,18,36,0" child_margin="20">
                <VBox width="46%" height="stretch">
                    <HBox height="44" child_margin="10" valign="center">
                        <Button name="btn_player_back_top" class="ne_player_icon" text="▼"/>
                        <Control width="stretch" height="stretch" mouse_enabled="false"/>
                        <Label class="ne_player_sub" text="播放器模式"/>
                    </HBox>
                    <Control width="stretch" height="8"/>
                    <Control name="ne_vinyl_image" width="400" height="548" halign="center" valign="center"
                             bkimage="file='images/netease/netease_vinyl_720x985.png' adaptive_dest_rect='true' halign='center' valign='center'"/>
                    <Control width="stretch" height="stretch" mouse_enabled="false"/>
                </VBox>

                <VBox width="54%" height="stretch" padding="20,48,10,0" child_margin="8">
                    <HBox height="42" valign="center" child_margin="12">
                        <Label class="ne_player_title" name="ne_player_page_title" text="未选择"/>
                        <Button class="ne_chip" text="本地"/>
                    </HBox>
                    <Label class="ne_player_sub" name="ne_player_page_meta" text="来源：本地音乐"/>
                    <VBox width="stretch" height="stretch" child_margin="0">
                        <Control width="stretch" height="stretch" mouse_enabled="false"/>
                        <VBox name="ne_lyrics_box" width="stretch" height="auto" child_margin="2">
                            <Label name="ne_lyric_0" class="ne_lyric_line" width="stretch"/>
                            <Label name="ne_lyric_1" class="ne_lyric_line" width="stretch"/>
                            <Label name="ne_lyric_2" class="ne_lyric_line" width="stretch"/>
                            <Label name="ne_lyric_3" class="ne_lyric_line" width="stretch"/>
                            <Label name="ne_lyric_4" class="ne_lyric_line" width="stretch"/>
                            <Label name="ne_lyric_5" class="ne_lyric_line" width="stretch"/>
                            <Label name="ne_lyric_6" class="ne_lyric_line" width="stretch"/>
                            <Label name="ne_lyric_7" class="ne_lyric_line" width="stretch"/>
                            <Label name="ne_lyric_8" class="ne_lyric_line" width="stretch"/>
                        </VBox>
                        <Control width="stretch" height="stretch" mouse_enabled="false"/>
                    </VBox>
                </VBox>
            </HBox>

            <VBox width="stretch" height="38" padding="30,10,30,0">
                <Slider name="slider_progress" class="ne_player_slider"/>
            </VBox>

            <HBox name="ne_bottom_player" width="stretch" height="92" bkcolor="#FF1E1E24"
                  padding="24,0,24,0" valign="center">
                <HBox width="240" height="stretch" valign="center" child_margin="12">
                    <Button name="btn_player_back" class="ne_bottom_cover" text="▼" valign="center"/>
                    <VBox width="stretch" height="auto" valign="center" child_margin="2">
                        <Label class="ne_player_title" name="ne_player_bottom_title" text="未选择"/>
                        <Label class="ne_player_sub" name="ne_player_bottom_artist" text=""/>
                    </VBox>
                </HBox>
                <Control width="stretch" height="stretch" mouse_enabled="false"/>
                <HBox valign="center" child_margin="24" width="204">
                    <Button name="btn_ne_prev_player" class="ne_media_btn" valign="center"
                            normal_image="file='images/netease/prev_52.png' width='52' height='52' valign='center' halign='center'"/>
                    <Button name="btn_ne_play_pause_player" class="ne_play_round" valign="center"
                            normal_image="file='images/netease/play_52.png' width='24' height='24' valign='center' halign='center'"/>
                    <Button name="btn_ne_next_player" class="ne_media_btn" valign="center"
                            normal_image="file='images/netease/next_52.png' width='52' height='52' valign='center' halign='center'"/>
                </HBox>
                <Control width="stretch" height="stretch" mouse_enabled="false"/>
                <Control width="240" height="stretch" mouse_enabled="false"/>
            </HBox>
        </VBox>
    </VBox>
</Window>
