                <VBox width="stretch" height="stretch" bkcolor="#FFFFFFFF">
                    <!-- 本地音乐 -->
                    <VBox name="ne_page_local" class="ne_page">
                        <HBox height="46" valign="center" child_margin="10">
                            <Label class="ne_title" text="本地音乐"/>
                            <Label class="ne_sub" text="共 3 首"/>
                            <Control width="stretch" height="stretch" mouse_enabled="false"/>
                            <Button class="ne_link_btn" text="选择目录 &gt;"/>
                        </HBox>

                        <HBox height="48" valign="center" child_margin="10">
                            <Button class="ne_primary_btn" text="▶  播放全部"/>
                            <Button class="ne_round_btn" text="↻"/>
                            <Button class="ne_round_btn" text="..."/>
                            <Control width="stretch" height="stretch" mouse_enabled="false"/>
                            <SearchBox class="search_box" width="220" height="34" prompt_text="搜索本地音乐"/>
