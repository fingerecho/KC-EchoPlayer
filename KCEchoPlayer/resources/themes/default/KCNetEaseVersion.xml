                    <Label class="ne_section_title" text="音乐库" height="28" margin="12,0,0,4"/>
                    <Option name="nav_local" class="ne_nav_item" group="ne_nav" selected="true" text="本地音乐"
                            normal_image="file='images/netease/06_music_box_gray.png' width='16' height='16' valign='center'"
                            selected_normal_image="file='images/netease/06_music_box_white.png' width='16' height='16' valign='center'"/>
                    <Option name="nav_recent" class="ne_nav_item" group="ne_nav" text="最近播放"
                            normal_image="file='images/netease/02_circle_l_gray.png' width='16' height='16' valign='center'"
                            selected_normal_image="file='images/netease/02_circle_l_white.png' width='16' height='16' valign='center'"/>
                    <Option name="nav_favorite" class="ne_nav_item" group="ne_nav" text="我的收藏"
                            normal_image="file='images/netease/04_star_gray.png' width='16' height='16' valign='center'"
                            selected_normal_image="file='images/netease/04_star_white.png' width='16' height='16' valign='center'"/>
                    <Option name="nav_settings" class="ne_nav_item" group="ne_nav" text="设置"
                            normal_image="file='images/netease/08_settings_gray.png' width='16' height='16' valign='center'"
                            selected_normal_image="file='images/netease/08_settings_white.png' width='16' height='16' valign='center'"/>
                    <Control width="stretch" height="stretch" mouse_enabled="false"/>
                </VBox>
                <Control width="1" height="stretch" bkcolor="#FFE9E9EF" mouse_enabled="false"/>

