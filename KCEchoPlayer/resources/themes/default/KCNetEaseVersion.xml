<?xml version="1.0" encoding="utf-8"?>
<!-- 网易V2版界面：本地音乐 / 最近播放 / 我的收藏 / 设置 + 播放页 -->
<Window size="1280,800" min_size="1024,640" caption="0,0,0,56"
        round_corner="14,14" size_box="4,4,4,4"
        shadow_type="none_round" shadow_attached="true"
        shadow_border_round="14,14" shadow_border_size="0">

    <!-- ===================== 网易V2版局部样式 ===================== -->
    <Class name="ne_nav_item" width="stretch" height="40" border_round="8,8" padding="14,0,14,0"
           text_padding="34,0,0,0" font="system_regular_15" normal_text_color="#FF4C4C57"
           hovered_text_color="#FF1F1F24" selected_normal_text_color="#FFFFFFFF"
           selected_hovered_text_color="#FFFFFFFF" selected_pressed_text_color="#FFFFFFFF"
           normal_color="#00000000" hovered_color="#FFEAEAF2"
           selected_normal_color="#FFF53B4B" selected_hovered_color="#FFF53B4B"
           selected_pressed_color="#FFF53B4B" text_align="vcenter,left"/>
    <Class name="ne_section_title" font="system_bold_13" normal_text_color="#FF9A9AA8" text_align="vcenter"/>
    <Class name="ne_page" width="stretch" height="stretch" bkcolor="#FFFFFFFF" padding="32,24,32,10"/>
    <Class name="ne_solid_page" width="stretch" height="stretch"/>
    <Class name="ne_title" font="system_bold_22" normal_text_color="#FF202026" text_align="vcenter"/>
    <Class name="ne_sub" font="system_regular_13" normal_text_color="#FF8A8A97" text_align="vcenter"/>
    <Class name="ne_body" font="system_regular_14" normal_text_color="#FF4D4D58" text_align="vcenter"/>
    <Class name="ne_muted" font="system_regular_12" normal_text_color="#FFA5A5B2" text_align="vcenter"/>
    <Class name="ne_primary_btn" width="120" height="38" border_round="19,19" font="system_bold_14"
           text_align="hcenter,vcenter" normal_text_color="#FFFFFFFF"
           normal_color="#FFF53B4B" hovered_color="#FFE53040" pressed_color="#FFD82131"/>
    <Class name="ne_round_btn" width="38" height="38" border_round="19,19" font="system_regular_15"
           text_align="hcenter,vcenter" normal_text_color="#FF50505C"
           normal_color="#FFF2F2F6" hovered_color="#FFE7E7EE" pressed_color="#FFDDDDE6"/>
    <Class name="ne_ghost_btn" width="auto" height="30" padding="10,0,10,0" border_round="15,15"
           font="system_regular_13" text_align="hcenter,vcenter" normal_text_color="#FF666672"
           normal_color="#00FFFFFF" hovered_text_color="#FFF53B4B" hovered_color="#FFFFF0F1"/>
    <Class name="ne_link_btn" width="auto" height="30" padding="8,0,8,0" font="system_regular_13"
           text_align="hcenter,vcenter" normal_text_color="#FF4C6FFF" hovered_text_color="#FF1F49FF"/>
    <Class name="ne_list" bkcolor="#00FFFFFF" vscrollbar="true"/>
    <Class name="ne_list_row" height="58" border_round="6,6"
           hovered_color="#FFF4F4F8" selected_normal_color="#FFEDEDF3" fade_hovered="false"/>
    <Class name="ne_list_header" height="34" bkcolor="#FFF7F7FA" border_round="4,4"/>
    <Class name="ne_song_title" font="system_regular_15" normal_text_color="#FF222228" text_align="vcenter"/>
    <Class name="ne_song_title_red" font="system_regular_15" normal_text_color="#FFF53B4B" text_align="vcenter"/>
    <Class name="ne_song_artist" font="system_regular_12" normal_text_color="#FF8A8A97" text_align="vcenter"/>
    <Class name="ne_song_artist_red" font="system_regular_12" normal_text_color="#FFF53B4B" text_align="vcenter"/>
    <Class name="ne_col" font="system_regular_13" normal_text_color="#FF777783" text_align="vcenter"/>
    <Class name="ne_col_light" font="system_regular_13" normal_text_color="#FFB0B0BC" text_align="vcenter"/>
    <Class name="ne_cover_small" border_round="6,6" bkcolor="#FFF53B4B"/>
    <Class name="ne_tag_tab" width="auto" height="34" padding="12,0,12,0" border_round="17,17"
           font="system_regular_13" normal_text_color="#FF666672" normal_color="#00FFFFFF"
           hovered_color="#FFF4F4F8" selected_normal_text_color="#FF1F1F24"
           selected_normal_color="#FFEFEFF4" text_align="hcenter,vcenter"/>
    <Class name="ne_play_round" width="52" height="52" border_round="26,26"
           normal_color="#FFF53B4B" hovered_color="#FFE53040" pressed_color="#FFD82131"/>
    <Class name="ne_media_btn" width="52" height="52" border_round="26,26"
           normal_color="#00FFFFFF" hovered_color="#14F53B4B" pressed_color="#22F53B4B"/>
    <Class name="ne_bottom_icon" width="34" height="34" border_round="17,17" font="system_regular_16"
           text_align="hcenter,vcenter" normal_text_color="#FF3E3E49"
           hovered_text_color="#FFF53B4B" hovered_color="#FFF4F4F8" pressed_color="#FFEDEDF3"/>
    <Class name="ne_bottom_cover" width="56" height="56" border_round="28,28" font="system_bold_20"
           text_align="hcenter,vcenter" normal_text_color="#FFFFFFFF"
           normal_color="#FF3C3C48" hovered_color="#FF50505E" pressed_color="#FF2E2E38"/>
    <Class name="ne_chip" width="auto" height="26" padding="9,0,9,0" border_round="13,13"
           border_size="1" border_color="#FFD7D7E0" font="system_regular_12"
           text_align="hcenter,vcenter" normal_text_color="#FF6B6B78"
           normal_color="#00FFFFFF" hovered_color="#FFF4F4F8"/>
    <Class name="ne_player_icon" width="42" height="42" border_round="21,21" font="system_regular_16"
           text_align="hcenter,vcenter" normal_text_color="#FFDADAE6"
           normal_color="#00FFFFFF" hovered_color="#FF35353F" pressed_color="#FF2A2A34"/>
    <Class name="ne_player_back" width="50" height="50" border_round="25,25" font="system_bold_18"
           text_align="hcenter,vcenter" normal_text_color="#FFFFFFFF"
           normal_color="#FF35353F" hovered_color="#FF474752" pressed_color="#FF2A2A34"/>
    <Class name="ne_player_title" font="system_bold_22" normal_text_color="#FFFFFFFF" text_align="vcenter"/>
    <Class name="ne_player_sub" font="system_regular_14" normal_text_color="#FFAFAFBE" text_align="vcenter"/>
    <Class name="ne_player_lyric" font="system_regular_16" normal_text_color="#FF8F8F9E" text_align="vcenter"/>
    <Class name="ne_record_outer" bkcolor="#FF15151B" border_round="210,210"/>
    <Class name="ne_record_inner" bkcolor="#FF353540" border_round="155,155"/>
    <Class name="ne_record_center" bkcolor="#FFB35A3C" border_round="105,105"/>
    <Class name="ne_player_slider" horizontal="true" width="stretch" height="4" min="0" max="1000"
           progress_color="#FFF53B4B" bkcolor="#FF3A3A45" border_round="2,2" progress_radius="2"
           thumb_size="10,10"
           thumb_normal_image="file='${PATH_SLIDER}/slider_thumb.svg' width='10' height='10'"
           thumb_hovered_image="file='${PATH_SLIDER}/slider_thumb_hovered.svg' width='10' height='10'"
           thumb_pressed_image="file='${PATH_SLIDER}/slider_thumb_pressed.svg' width='10' height='10'"/>

    <VBox bkcolor="#FFF8F8FB" width="stretch" height="stretch"
          border_size="1" border_round="14,14" border_color="#FFE6E6EE">

        <!-- ===================== 标题栏：与 KCEchoPlayerMain 排版一致 ===================== -->
        <HBox name="window_title_bar" height="56" bkcolor="#FFFFFFFF" padding="20,0,16,0">
            <HBox valign="center" width="auto" margin="0,15,0,0">
                <Control width="24" height="24" border_round="12,12" bkcolor="#FFF53B4B" margin="0,0,10,0"/>
                <Label class="mc_title_text" text="克铖云音乐"/>
            </HBox>
            <Control width="stretch" height="stretch" mouse_enabled="false"/>
            <Button class="mc_win_btn" name="btn_select_version" text="版本选择" width="76" margin="0,0,6,0"/>
            <HBox valign="center" width="auto" child_margin="6">
                <Button class="mc_win_btn" name="btn_window_min" text="—"/>
                <Button class="mc_win_btn" name="btn_window_max" text="□"/>
                <Button class="mc_win_btn" name="btn_window_restore" text="❐" visible="false"/>
                <Button class="mc_win_btn" name="btn_window_close" text="✕"/>
            </HBox>
        </HBox>

        <!-- ===================== 正常浏览界面 ===================== -->
        <VBox name="ne_body_normal" width="stretch" height="stretch">
            <HBox width="stretch" height="stretch">
                <!-- 左侧菜单 -->
