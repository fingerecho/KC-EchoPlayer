                                <HBox padding="13,0,13,0" height="stretch" valign="center" child_margin="10">
                                    <Label class="ne_col_light" text="▶" width="36"/>
                                    <VBox width="stretch" height="stretch" valign="center" child_margin="1">
                                        <Label class="ne_song_title_red" text="岁月"/>
                                        <Label class="ne_song_artist_red" text="王菲 / 那英"/>
                                    </VBox>
